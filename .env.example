# Cyano Wallet runtime configuration (see config/env.js).
# Copy this file to ".env" (or ".env.local") and replace placeholders with
# real values. Never commit real values or a populated .env file.
#
# Bugsnag project API key (used by src/background/index.ts and src/popup/index.tsx).
REACT_APP_BUGSNAG_API_KEY=<your-bugsnag-api-key>
